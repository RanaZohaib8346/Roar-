{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User's learning profile and statistics.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "email": { "type": "string" },
        "selectedCourseId": { "type": "string" },
        "streak": { "type": "integer" },
        "totalXP": { "type": "integer" },
        "gems": { "type": "integer" },
        "learningLevel": { "type": "string", "enum": ["beginner", "basic", "pro"] },
        "lastActive": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "totalXP", "streak"]
    },
    "Course": {
      "title": "Course",
      "description": "A language course (e.g., Spanish, French).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "flag": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "A specific learning unit within a course.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "title": { "type": "string" },
        "order": { "type": "integer" },
        "xp": { "type": "integer" },
        "type": { "type": "string", "enum": ["vocabulary", "grammar", "practice"] }
      },
      "required": ["id", "courseId", "title", "order"]
    },
    "UserProgress": {
      "title": "User Progress",
      "description": "Tracks a user's completion of a specific lesson.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "lessonId": { "type": "string" },
        "completed": { "type": "boolean" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "lessonId", "completed"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user profiles."
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Available language courses."
    },
    "/lessons/{lessonId}": {
      "schema": "Lesson",
      "description": "Lessons defining the curriculum."
    },
    "/users/{userId}/progress/{progressId}": {
      "schema": "UserProgress",
      "description": "Granular user progress per lesson."
    }
  }
}
